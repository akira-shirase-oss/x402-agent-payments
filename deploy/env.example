# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/xpay/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/xpay-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/xpay-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# XPAY_LISTEN=127.0.0.1:63350
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# XPAY_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/xpay.service) less the pool and some headroom.
# XPAY_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# XPAY_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# XPAY_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# XPAY_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# XPAY_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# XPAY_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/xpay-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# XPAY_REQUEST_TIMEOUT_MS=5000
# XPAY_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# XPAY_MAX_IN_FLIGHT=64

# --- Database (crates/xpay-db) ------------------------------------------------------
# XPAY_DB_MAX_CONNECTIONS=16
# XPAY_DB_ACQUIRE_TIMEOUT_MS=2000
# XPAY_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# XPAY_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# XPAY_STARTUP_TIMEOUT_MS=30000

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least XPAY_ERROR_MIN_REQUESTS were answered.
# XPAY_ERROR_RATE_PERMILLE=50
# XPAY_ERROR_MIN_REQUESTS=20
# XPAY_LOG=info
# json for journald; text for a terminal.
# XPAY_LOG_FORMAT=json

# --- Accounts (crates/xpay-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# XPAY_SMTP_RELAY=
# XPAY_MAIL_FROM=noreply@x402-agent-payments.invalid
# Where links in emails point.
# XPAY_PUBLIC_URL=http://127.0.0.1:63350
# XPAY_COOKIE_SECURE=true
# XPAY_SESSION_TTL_S=604800
# XPAY_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# XPAY_TRUSTED_PROXIES=
# XPAY_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# XPAY_PLAN_MAX_MEMBERS=10
# XPAY_PLAN_MAX_TOKENS=10
# XPAY_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/xpay/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role xpay_app
#   migration-database-url  xpayctl migrate, digests, fingerprint, prune-events (xpay_owner)
#   admin-database-url      xpayctl bootstrap only
#   owner-password          xpayctl bootstrap only
#   app-password            xpayctl bootstrap only
# XPAY_DATABASE_URL_FILE=/etc/xpay/credentials/database-url
# XPAY_MIGRATION_DATABASE_URL_FILE=/etc/xpay/credentials/migration-database-url
# XPAY_ADMIN_DATABASE_URL_FILE=/etc/xpay/credentials/admin-database-url
# XPAY_OWNER_PASSWORD_FILE=/etc/xpay/credentials/owner-password
# XPAY_APP_PASSWORD_FILE=/etc/xpay/credentials/app-password
