# Caddy in front of the service (docs/OPERATIONS.md, "Install"). Install as
# /etc/systemd/system/caddy.service, with /etc/caddy/Caddyfile from deploy/Caddyfile and
# /etc/caddy/env holding XPAY_DOMAIN. Based on Caddy's own unit: a dedicated user that
# may bind 80 and 443 and nothing more, its certificates in its state directory.

[Unit]
Description=Caddy (TLS and reverse proxy for starter)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/caddy/env
Environment=HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --environ --config /etc/caddy/Caddyfile
# The Caddyfile turns the admin endpoint off, so a configuration change is a restart.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
StateDirectory=caddy
StateDirectoryMode=0700
LimitNOFILE=8192
MemoryMax=256M
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
